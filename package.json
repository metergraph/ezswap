{
  "name": "metergraph-replay",
  "version": "0.0.0",
  "description": "Replay your production LLM calls on other models and see what would change, read against a noise floor",
  "type": "module",
  "bin": {
    "metergraph-replay": "bin/metergraph-replay.js"
  },
  "files": [
    "bin/metergraph-replay.js",
    "dist/**/*.js",
    "dist/**/*.json",
    "demo/**",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli/main.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "build:demo": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-demo.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "license": "Apache-2.0",
  "author": "Metergraph",
  "homepage": "https://www.metergraph.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metergraph/replay.git"
  },
  "bugs": {
    "url": "https://github.com/metergraph/replay/issues"
  },
  "keywords": [
    "llm",
    "evaluation",
    "model-swap",
    "cost",
    "openai",
    "anthropic",
    "langfuse",
    "opentelemetry",
    "metergraph"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.8.2",
    "yaml": "^2.9.1"
  }
}
